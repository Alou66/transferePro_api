NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Origine autorisée par CORS. En dev, l'URL du serveur Vite (défaut : http://localhost:5173).
# En production, OBLIGATOIRE : renseignez le vrai domaine du frontend déployé.
FRONTEND_URL=http://localhost:5173

# Valeurs factices : à remplacer obligatoirement avant tout déploiement.
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Example
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=00 0000000
ADMIN_PASSWORD=changeme

JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h
